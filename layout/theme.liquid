<!doctype html>
<html class='no-js' lang='{{ request.locale.iso_code }}'>
  <head>
    <meta charset='utf-8'>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <meta
      name='viewport'
      content='width=device-width,initial-scale=1,viewport-fit=cover'
    >
    <meta name='color-scheme' content='only dark'>
    <meta name='theme-color' content='#0C0C0C'>
    <link rel='canonical' href='{{ canonical_url }}'>

    <title>
      {{ page_title }}
      {%- if current_tags %}
        &ndash; tagged "{{ current_tags | join: ', ' }}"
      {%- endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %}
        &ndash; {{ shop.name -}}
      {%- endunless -%}
    </title>

    {% if page_description %}
      <meta name='description' content='{{ page_description | escape }}'>
    {% endif %}

    {{ content_for_header }}

    <!-- ZERØLIFE Cyber Tokens, Fonts & CRT Filters -->
    {% render 'cyber-tokens' %}

    <!-- Live Shopify Product Data Bridge to window.ZL_PRODUCTS -->
    {% render 'shopify-products-bridge' %}

    <link rel='stylesheet' href='https://use.typekit.net/aiz3fbt.css'>
    <link rel='stylesheet' href='{{ 'theme.css' | asset_url }}'>
    <link rel='stylesheet' href='{{ 'desktop-overlays.css' | asset_url }}'>
    <link rel='stylesheet' href='{{ 'logo-pixel.css' | asset_url }}'>
    <link rel='stylesheet' href='{{ 'tokens.css' | asset_url }}'>

    {% comment %}
      <script
        src='{{ 'theme.js' | asset_url }}'
        defer='defer'
        type='module'
      ></script>
    {% endcomment %}
    <script
      src='{{ 'three.min.js' | asset_url }}'
      type='module'
    ></script>
    <script
      src='{{ 'pixel-noise.js' | asset_url }}'
      type='module'
    ></script>
    <script
      src='{{ 'crt.js' | asset_url }}'
      type='module'
    ></script>
    <script
      src='{{ 'enter-symbol.js' | asset_url }}'
      type='module'
    ></script>

    <!--
      The room (what comes after the click), on this same page.
      The Ø's effects over the whole screen, and its glow. Built by tools/build-room-fx.mjs.
    -->
    <script src='{{'room-fx.js' | asset_url}}' type='module'></script>
    <!--
      ('room-test-image.js, the test picture you could drag around, is no longer loaded: it was switched off in
      'room.js anyway, Nov 4 2026. Add its script line back here to bring it back.)
      The 3D mannequins ('room-tee.js). GLTFLoader is three 0.160.1's, as a plain script.
    -->
    <script src='{{'GLTFLoader.js' | asset_url}}' type='module'></script>
    <!--
      The CLO animations are packed with meshopt; lit with three's studio room.
    -->
    <script src='{{'meshopt_decoder.js' | asset_url}}' type='module'></script>
    <script src='{{'RoomEnvironment.js' | asset_url}}' type='module'></script>
    <!--
      The mannequins' own files ('catwalk-glb.js, 'hoodie-glb.js and their falls, ~55 MB) are NOT listed here
      (Nov 4 2026): 'room.js fetches them one by one once the page has loaded (see MODEL_FILES there).
    -->
    <script src='{{'room-tee.js' | asset_url}}' type='module'></script>

    <!--
      MAKESHIFT: the item panel beside an open model (its words, then the panel itself).
    -->
    <script src='{{'product-info.js' | asset_url}}' type='module'></script>
    <script src='{{'product-thumbs.js' | asset_url}}' type='module'></script>
    <!--
      The cart's queue, shared with the phone page (same queue in the same browser): its saved list and words.
    -->
    <script src='{{'cart.js' | asset_url}}' type='module'></script>
    <script src='{{'room-panel.js' | asset_url}}' type='module'></script>
    <!--
      TEMPORARY: every page the site needs, as the machine's file directory ([ 03 // ROOT ]).
    -->
    <script src='{{'site-pages.js' | asset_url}}' type='module'></script>
    <script src='{{'room-pages.js' | asset_url}}' type='module'></script>
    <!-- The cart page: the RECOVERY QUEUE, drawn like the pages. -->
    <script src='{{'room-queue.js' | asset_url}}' type='module'></script>
    <!-- The menu terminal, as on the phone. -->
    <script src='{{'room-menu.js' | asset_url}}' type='module'></script>
    <!--
      The enter video (old site's Enter_animation_web.webm), played once through the effects. Built by tools/build-enter-video.mjs.
    -->
    <script src='{{'enter-video.js' | asset_url}}' type='module'></script>
    <script src='{{'room.js' | asset_url}}' type='module'></script>
  </head>

  <body>
    {% comment %}
      <a
        class='sr-only'
        href='#MainContent'
      >
        Skip to content
      </a>

      {% sections 'header-group' %}
    {% endcomment %}

    <main
      id='MainContent'
      role='main'
      tabindex='-1'
    >
      {{ content_for_layout }}
    </main>

    {% comment %} {% sections 'footer-group' %} {% endcomment %}

    <!--
      Persistent Status Queue Bar (glitches in when items are held in queue)
    -->
    <div
      id='queue-bar'
      hidden
      role='button'
      aria-label='Open Recovery Queue'
    ></div>

    <!-- Global Persistent Modals (RECOVERY QUEUE & ROOT Terminal) -->
    {% comment %} {% section 'recovery-queue' %} {% endcomment %}
    {% comment %} {% section 'root-terminal' %} {% endcomment %}
  </body>
</html>
