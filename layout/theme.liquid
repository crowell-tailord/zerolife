<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0f172a">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <!-- Compiled theme stylesheets from Vite -->
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript>{{ 'theme.css' | asset_url | stylesheet_tag }}</noscript>
  </head>

  <body class="bg-black text-white min-h-screen flex flex-col antialiased selection:bg-white selection:text-black">
    <a class="sr-only focus:not-sr-only p-4 bg-white text-black absolute top-0 z-50 font-mono text-xs uppercase" href="#MainContent">
      Skip to content
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" class="flex-grow focus:none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <!-- Compiled global theme script from Vite -->
    <script src="{{ 'theme.js' | asset_url }}" defer="defer" type="module"></script>
  </body>
</html>
