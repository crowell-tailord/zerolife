{
  "name": "zerolife-shopify-theme",
  "version": "1.0.0",
  "description": "High-fidelity custom Shopify theme with React + Three.js islands",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --emptyOutDir false",
    "build": "vite build",
    "shopify:dev": "shopify theme dev --store=zl-dev-si3z91gv.myshopify.com",
    "deploy": "npm run build && shopify theme push"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
