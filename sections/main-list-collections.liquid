<section class="py-8 md:py-16 px-4 max-w-7xl mx-auto space-y-12">
  
  <!-- Header -->
  <div class="border-b border-slate-900 pb-8 space-y-2">
    <span class="text-xs font-mono tracking-widest text-emerald-400 uppercase">// DIRECTORY: COLLECTIONS</span>
    <h1 class="text-3xl md:text-5xl font-mono font-black tracking-tight text-slate-100 uppercase">
      ALL COLLECTIONS
    </h1>
  </div>

  <!-- Grid of Collections -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <div class="group relative flex flex-col bg-slate-950/45 border border-slate-900 rounded-2xl overflow-hidden hover:border-emerald-500/50 transition-all duration-300">
          
          <!-- Image -->
          <div class="aspect-[16/10] overflow-hidden bg-slate-950 flex items-center justify-center border-b border-slate-900">
            <a href="{{ collection.url }}" class="w-full h-full">
              {%- if collection.featured_image -%}
                <img 
                  src="{{ collection.featured_image | image_url: width: 600 }}" 
                  alt="{{ collection.title | escape }}"
                  class="w-full h-full object-cover transition-all duration-500 group-hover:scale-105"
                  loading="lazy"
                  width="400"
                  height="250"
                >
              {%- elsif collection.products.first.featured_image -%}
                <img 
                  src="{{ collection.products.first.featured_image | image_url: width: 600 }}" 
                  alt="{{ collection.title | escape }}"
                  class="w-full h-full object-cover transition-all duration-500 group-hover:scale-105"
                  loading="lazy"
                  width="400"
                  height="250"
                >
              {%- else -%}
                <div class="w-full h-full flex items-center justify-center text-slate-700 text-xs font-mono">// EMPTY_COLLECTION</div>
              {%- endif -%}
            </a>
          </div>

          <!-- Info -->
          <div class="p-6 flex flex-col justify-between flex-grow gap-4">
            <div class="space-y-1">
              <span class="text-[10px] font-mono tracking-widest text-slate-500 uppercase">
                // SYSTEM_CLASS: {{ collection.products_count }} ITEMS
              </span>
              <h3 class="font-mono text-lg font-bold text-slate-200 group-hover:text-emerald-400 transition-colors uppercase">
                <a href="{{ collection.url }}">{{ collection.title }}</a>
              </h3>
              {%- if collection.description != blank -%}
                <p class="text-xs text-slate-400 line-clamp-2 font-sans leading-relaxed mt-2">
                  {{ collection.description | strip_html }}
                </p>
              {%- endif -%}
            </div>

            <a 
              href="{{ collection.url }}" 
              class="inline-flex items-center text-xs font-mono font-bold text-emerald-400 hover:text-emerald-300 transition-colors uppercase border-t border-slate-900/60 pt-4"
            >
              ACCESS_SECTOR &gt;
            </a>
          </div>

        </div>
      {%- endunless -%}
    {%- endfor -%}
  </div>

</section>

{% schema %}
{
  "name": "Main Collections List",
  "settings": []
}
{% endschema %}
