<section class="py-8 md:py-16 px-4 max-w-3xl mx-auto space-y-8">
  <!-- Page Header -->
  <div class="border-b border-slate-900 pb-6">
    <span class="text-xs font-mono tracking-widest text-emerald-400 uppercase">// RECORD_PAGE</span>
    <h1 class="text-3xl md:text-5xl font-mono font-black tracking-tight text-slate-100 uppercase">
      {{ page.title }}
    </h1>
  </div>

  <!-- Page Content -->
  <div class="prose prose-invert max-w-none text-slate-300 text-sm md:text-base leading-relaxed font-sans space-y-6">
    {{ page.content }}
  </div>
</section>

