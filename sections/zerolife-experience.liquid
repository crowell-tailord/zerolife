{% comment %}
  ZERØLIFE Experiential Homepage Section:
  Single responsive 3D showroom stage with top nav HUD, interactive model switchers, and docked product dossier.
{% endcomment %}

<div id="zerolife-homepage-root" class="relative w-full min-h-screen bg-[#0C0C0C] text-[#E4DFD3] overflow-hidden">
  
  <!-- 3D Showroom & Product Stage (Unified Responsive Layout) -->
  <div id="showroom-stage" class="w-full min-h-screen flex flex-col lg:grid lg:grid-cols-12 relative">
    
    <!-- Left/Top: 3D Stage -->
    <div id="home-3d-stage" class="w-full h-[60vh] lg:h-screen lg:col-span-7 xl:col-span-8 lg:sticky lg:top-0 relative overflow-hidden bg-[#0C0C0C]">
      <canvas id="home-3d-canvas" class="w-full h-full block cursor-grab active:cursor-grabbing touch-action-none"></canvas>

      <!-- Nav & Controls Overlay -->
      <div class="absolute top-0 inset-x-0 p-4 lg:p-8 flex justify-between items-center z-10 font-mono text-xs phosphor-text">
        <div class="flex items-center gap-3">
          <button type="button" onclick="window.dispatchEvent(new CustomEvent('zerolife:open-root'))" class="border border-[#2a2c2e] bg-black/50 hover:border-[#E4DFD3] px-3 py-1.5 text-[#E4DFD3] cursor-pointer">
            [ 03 // ROOT ]
          </button>
          <a href="/collections/all" class="border border-[#2a2c2e] bg-black/50 hover:border-[#E4DFD3] px-3 py-1.5 text-[#BFC3C6] hover:text-white">
            [ ARCHIVE ]
          </a>
        </div>

        <div class="flex items-center gap-2">
          <span class="text-[#8B9094] hidden sm:inline">// HOLD TO FREEZE</span>
          <span class="text-[#00ff66] border border-[#2a2c2e] bg-black/40 px-2 py-1">[ 60 FPS ]</span>
        </div>
      </div>

      <!-- Model Switcher Buttons -->
      <div class="absolute bottom-6 left-6 z-10 flex gap-2 font-mono text-xs phosphor-text">
        <button type="button" class="home-model-btn zl-btn text-xs py-2 px-3 picked" data-model="tee">[ 01 // TEE ]</button>
        <button type="button" class="home-model-btn zl-btn text-xs py-2 px-3" data-model="catwalk">[ 02 // CATWALK ]</button>
        <button type="button" class="home-model-btn zl-btn text-xs py-2 px-3" data-model="hoodie">[ 03 // HOODIE ]</button>
      </div>

      <div class="fade-bottom lg:hidden absolute bottom-0 inset-x-0 h-16 bg-gradient-to-b from-transparent to-[#0C0C0C] pointer-events-none"></div>
    </div>

    <!-- Right/Bottom: Featured Product Dossier -->
    <div id="home-dossier" class="w-full lg:col-span-5 xl:col-span-4 p-6 lg:p-12 lg:min-h-screen flex flex-col justify-center phosphor-text z-10 bg-[#0C0C0C] lg:bg-[#0C0C0C]/90 backdrop-blur-none lg:backdrop-blur-md border-t lg:border-t-0 lg:border-l border-[#2a2c2e]">
      {% assign featured_product = collections['frontpage'].products.first | default: collections.all.products.first %}
      {% render 'product-dossier-panel', product: featured_product %}
    </div>

  </div>

</div>
