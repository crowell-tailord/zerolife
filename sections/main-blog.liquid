{%- paginate blog.articles by 6 -%}
<section class="py-8 md:py-16 px-4 max-w-7xl mx-auto space-y-12">
  
  <!-- Blog Header -->
  <div class="border-b border-slate-900 pb-8 space-y-2">
    <span class="text-xs font-mono tracking-widest text-emerald-400 uppercase">// INTEL_FEED</span>
    <h1 class="text-3xl md:text-5xl font-mono font-black tracking-tight text-slate-100 uppercase">
      {{ blog.title }}
    </h1>
  </div>

  <!-- Articles Grid -->
  {%- if blog.articles.size > 0 -%}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {%- for article in blog.articles -%}
        <article class="flex flex-col bg-slate-950/45 border border-slate-900 rounded-2xl overflow-hidden hover:border-emerald-500/50 transition-all duration-300">
          
          <!-- Image -->
          {%- if article.image -%}
            <a href="{{ article.url }}" class="aspect-[16/10] overflow-hidden block border-b border-slate-900 bg-slate-950">
              <img 
                src="{{ article.image | image_url: width: 600 }}" 
                alt="{{ article.image.alt | escape }}"
                class="w-full h-full object-cover transition-all duration-500 hover:scale-105"
                loading="lazy"
                width="400"
                height="250"
              >
            </a>
          {%- endif -%}

          <!-- Content -->
          <div class="p-6 flex flex-col flex-grow justify-between gap-5">
            <div class="space-y-3">
              <div class="flex items-center gap-3 font-mono text-[10px] text-slate-500">
                <span>{{ article.published_at | date: "%Y-%m-%d" }}</span>
                <span>•</span>
                <span class="uppercase">BY {{ article.author }}</span>
              </div>

              <h3 class="font-mono text-base font-bold text-slate-200 hover:text-emerald-400 transition-colors uppercase line-clamp-2">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>

              <p class="text-xs text-slate-400 font-sans line-clamp-3 leading-relaxed">
                {%- if article.excerpt.size > 0 -%}
                  {{ article.excerpt | strip_html }}
                {%- else -%}
                  {{ article.content | strip_html | truncate: 180 }}
                {%- endif -%}
              </p>
            </div>

            <a 
              href="{{ article.url }}" 
              class="inline-flex items-center text-xs font-mono font-bold text-emerald-400 hover:text-emerald-300 transition-colors uppercase border-t border-slate-900/60 pt-4"
            >
              READ_INTEL &gt;
            </a>
          </div>

        </article>
      {%- endfor -%}
    </div>

    <!-- Pagination -->
    {%- if paginate.pages > 1 -%}
      <div class="flex items-center justify-center gap-2 pt-8 border-t border-slate-900 font-mono text-xs">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="px-4 py-2 border border-slate-800 rounded-lg hover:border-emerald-500 hover:text-emerald-400 transition-colors">&lt; PREV</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="px-3.5 py-2 border border-slate-800 rounded-lg hover:border-emerald-500 hover:text-emerald-400 transition-colors">{{ part.title }}</a>
          {%- else -%}
            {%- if part.title == paginate.current_page -%}
              <span class="px-3.5 py-2 border border-emerald-500/35 text-emerald-400 rounded-lg bg-emerald-500/5">{{ part.title }}</span>
            {%- else -%}
              <span class="px-3.5 py-2 text-slate-600">{{ part.title }}</span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="px-4 py-2 border border-slate-800 rounded-lg hover:border-emerald-500 hover:text-emerald-400 transition-colors">NEXT &gt;</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  {%- else -%}
    <div class="py-24 border border-dashed border-slate-900 rounded-3xl flex flex-col items-center justify-center text-center space-y-4">
      <div class="text-xs font-mono text-slate-600">// SCAN_COMPLETED: 0_ARTICLES_FOUND</div>
      <p class="text-sm text-slate-400 max-w-xs">No entries have been published on this feed yet.</p>
    </div>
  {%- endif -%}

</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Main Blog Feed",
  "settings": []
}
{% endschema %}
