<header class="w-full bg-black border-b border-white sticky top-0 z-40 px-6 py-4">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="{{ routes.root_url }}" class="flex items-center">
      <span class="text-lg font-mono font-bold tracking-widest text-white">ZEROLIFE</span>
    </a>

    <!-- Standard Nav Links (desktop only) -->
    <nav class="hidden md:flex items-center gap-6 font-mono text-xs uppercase text-white">
      {%- for link in linklists.main-menu.links -%}
        <a href="{{ link.url }}" class="hover:underline {% if link.current %}underline font-bold{% endif %}">
          {{ link.title }}
        </a>
      {%- else -%}
        <a href="/" class="hover:underline">Home</a>
        <a href="/collections/all" class="hover:underline">Catalog</a>
        <a href="/pages/about" class="hover:underline">About</a>
      {%- endfor -%}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-4">
      <a href="/cart" class="font-mono text-xs uppercase text-white hover:underline">
        CART [{{ cart.item_count }}]
      </a>
      
      <!-- Mobile Menu Toggle Button -->
      <button id="mobile-menu-toggle" class="block md:hidden text-white hover:opacity-80 focus:outline-none" aria-label="Toggle Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu (Initially Hidden) -->
  <div id="mobile-menu-drawer" class="hidden md:hidden w-full bg-black border-t border-white absolute top-full left-0 px-6 py-4 space-y-4">
    <nav class="flex flex-col gap-4 font-mono text-xs uppercase text-white">
      {%- for link in linklists.main-menu.links -%}
        <a href="{{ link.url }}" class="hover:underline {% if link.current %}underline font-bold{% endif %}">
          {{ link.title }}
        </a>
      {%- else -%}
        <a href="/" class="hover:underline">Home</a>
        <a href="/collections/all" class="hover:underline">Catalog</a>
        <a href="/pages/about" class="hover:underline">About</a>
      {%- endfor -%}
    </nav>
  </div>
</header>

<script>
  // Simple toggle script for the bare-bones mobile menu
  document.getElementById('mobile-menu-toggle')?.addEventListener('click', function() {
    const drawer = document.getElementById('mobile-menu-drawer');
    if (drawer) {
      drawer.classList.toggle('hidden');
    }
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
