{% comment %}
  ZERØLIFE Responsive Machine Header
{% endcomment %}
<header class="w-full bg-[#0C0C0C]/90 border-b border-[#2a2c2e] sticky top-0 z-40 px-4 lg:px-8 py-3 backdrop-blur-md phosphor-text">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    
    <!-- Brand Title -->
    <a href="{{ routes.root_url }}" class="flex items-center gap-2 group">
      <span class="font-human font-light text-xl tracking-tight text-[#E4DFD3] group-hover:text-white">ZERØLIFE</span>
      <span class="font-mono text-[10px] text-[#8B9094] border border-[#2a2c2e] px-1 py-0.5">SYS // V2.0</span>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-6 font-mono text-xs uppercase text-[#BFC3C6]">
      <a href="{{ routes.root_url }}" class="hover:text-[#E4DFD3] transition-colors {% if template.name == 'index' %}text-[#E4DFD3] underline underline-offset-4{% endif %}">
        [ 01 // SHOWROOM ]
      </a>
      <a href="{{ routes.all_products_collection_url }}" class="hover:text-[#E4DFD3] transition-colors {% if template.name == 'collection' %}text-[#E4DFD3] underline underline-offset-4{% endif %}">
        [ 02 // ARCHIVE ]
      </a>
      <button type="button" onclick="window.dispatchEvent(new CustomEvent('zerolife:open-root'))" class="hover:text-[#E4DFD3] transition-colors">
        [ 03 // ROOT ]
      </button>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <!-- Recovery Queue Trigger -->
      <button type="button" onclick="document.getElementById('recovery-queue')?.classList.remove('hidden')" class="font-mono text-xs text-[#E4DFD3] border border-[#2a2c2e] hover:border-[#E4DFD3] bg-black/40 px-3 py-1.5 flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[#00ff66]"></span>
        <span>QUEUE [{{ cart.item_count }}]</span>
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button type="button" onclick="window.dispatchEvent(new CustomEvent('zerolife:open-root'))" class="md:hidden font-mono text-xs border border-[#2a2c2e] px-2.5 py-1.5 text-[#BFC3C6]" aria-label="Menu">
        [ MENU ]
      </button>
    </div>

  </div>
</header>
