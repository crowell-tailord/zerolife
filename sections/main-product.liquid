{% comment %}
  ZERØLIFE Unified Responsive Product Detail Page (PDP):
  Single responsive layout with 3D garment inspection stage and phosphor product dossier.
{% endcomment %}

<section class="zerolife-viewport min-h-screen w-full bg-[#0C0C0C] text-[#E4DFD3] flex flex-col lg:grid lg:grid-cols-12 relative overflow-x-hidden">
  
  <!-- 3D Interactive Stage -->
  <div id="subject-stage" data-initial-model="{{ product.handle | default: 'tee' }}" class="w-full h-[55vh] lg:h-screen lg:col-span-7 xl:col-span-8 lg:sticky lg:top-0 relative overflow-hidden bg-[#0C0C0C]">
    <canvas id="subject-canvas" class="w-full h-full block cursor-grab active:cursor-grabbing touch-action-none"></canvas>
    
    <!-- Top HUD Overlays -->
    <div class="window-top absolute top-0 inset-x-0 p-4 lg:p-8 flex justify-between items-center pointer-events-none z-10 phosphor-text">
      <div class="flex items-center gap-3">
        <a href="/" class="pointer-events-auto font-mono text-xs text-[#E4DFD3] hover:text-white tracking-widest border border-[#2a2c2e] bg-black/40 px-3 py-1.5">
          ‹ [ ROOM ]
        </a>
        <button type="button" onclick="window.dispatchEvent(new CustomEvent('zerolife:open-root'))" class="pointer-events-auto font-mono text-xs text-[#BFC3C6] hover:text-[#E4DFD3] tracking-widest border border-[#2a2c2e] bg-black/40 px-3 py-1.5 cursor-pointer">
          [ ROOT ]
        </button>
      </div>

      <div class="flex items-center gap-2">
        <span class="font-mono text-xs text-[#8B9094] tracking-widest hidden sm:inline">// ROTATE & DRAG TO INSPECT</span>
        <span class="font-mono text-xs text-[#00ff66] tracking-widest border border-[#2a2c2e] bg-black/40 px-2 py-1">[ 60 FPS ]</span>
      </div>
    </div>

    <!-- Model Switcher Buttons (Bottom left of stage) -->
    <div class="absolute bottom-6 left-6 z-10 flex gap-2 font-mono text-xs phosphor-text">
      <button type="button" class="model-pick-btn zl-btn text-xs py-2 px-3 picked" data-model="tee">[ 01 // TEE ]</button>
      <button type="button" class="model-pick-btn zl-btn text-xs py-2 px-3" data-model="catwalk">[ 02 // CATWALK ]</button>
      <button type="button" class="model-pick-btn zl-btn text-xs py-2 px-3" data-model="hoodie">[ 03 // HOODIE ]</button>
    </div>

    <!-- Gradient fade edge for smooth transition to shop section on mobile -->
    <div class="fade-bottom lg:hidden absolute bottom-0 inset-x-0 h-16 bg-gradient-to-b from-transparent to-[#0C0C0C] pointer-events-none"></div>
  </div>

  <!-- Product Dossier (Single-column below on mobile, docked right sidebar on desktop) -->
  <div id="product-dossier" class="w-full lg:col-span-5 xl:col-span-4 p-6 lg:p-10 lg:min-h-screen flex flex-col justify-center phosphor-text z-10 bg-[#0C0C0C] lg:bg-[#0C0C0C]/90 backdrop-blur-none lg:backdrop-blur-md border-t lg:border-t-0 lg:border-l border-[#2a2c2e]">
    {% render 'product-dossier-panel', product: product %}
  </div>

</section>
